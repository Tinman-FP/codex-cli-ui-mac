CODEX_FREE_ONLY=1
CODEX_DEFAULT_PROFILE=manager
CODEX_DEFAULT_CWD=$HOME/Documents/Codex
CODEX_WEB_SEARCH=live

# Optional release-gate controls. The full local package suite currently needs
# several minutes; keep enough margin for slower model/browser checks.
CODEX_PACKAGE_HEALTH_TIMEOUT=900
CODEX_PACKAGE_HEALTH_SUPERVISOR_HEADROOM=300
CODEX_PACKAGE_HEALTH_BROWSER_TIMEOUT=240
CODEX_PACKAGE_HEALTH_FOCUSED_SMOKE_TIMEOUT=30

# Optional. Leave unset for free/local-only operation.
OPENAI_API_KEY=

# Optional eBay Browse API discovery. The app still searches and inspects
# public eBay item pages when these are unset. Production Buy API access may
# require approval from eBay; never commit the client secret.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US

# Optional local printer endpoint examples. Keep real values in private .env or data files.
QIDI_MOONRAKER_URL=http://printer-host.local:7125
